<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Borea.App.ViewModels"
             xmlns:views="using:Borea.App.Views"
             x:Class="Borea.App.Views.RuntimePromptModal"
             x:DataType="vm:MainViewModel">
    <!-- a launch through a Wine wrapper whose prefix lacks the .NET runtime of the loader -->
    <Panel Background="#99000000" views:ModalBackdrop.CloseButton="{Binding #CloseButton}">
        <Border Classes="modal" Width="561" Margin="80,0,0,0">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="24,24,24,0">
                    <TextBlock Classes="heading-lg" Text="{Binding Localization.LaunchRuntimeTitle}" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Grid.Column="1" Classes="icon" Command="{Binding CloseRuntimePromptCommand}" AutomationProperties.Name="{Binding Localization.ModalClose}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
                <Border Height="1" Background="{StaticResource Brush.Window}" Margin="0,24,0,0" />
                <StackPanel Margin="36,32,24,32" Spacing="16">
                    <TextBlock Classes="body-md" Text="{Binding RuntimePromptText}" TextWrapping="Wrap" />
                    <Button Classes="link" HorizontalAlignment="Left" Command="{Binding OpenRuntimeDownloadCommand}" ToolTip.Tip="{Binding PromptedRuntime.Runtime.DownloadPage}">
                        <TextBlock Classes="action-md" Text="{Binding RuntimeDownloadText}" />
                    </Button>
                    <TextBlock Classes="body-md danger" Text="{Binding RuntimePromptError}" TextWrapping="Wrap" IsVisible="{Binding RuntimePromptError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="text tall" Content="{Binding Localization.ModalClose}" Command="{Binding CloseRuntimePromptCommand}" VerticalAlignment="Center" />
                        <Button Classes="cta" Command="{Binding CheckRuntimeAgainCommand}" IsEnabled="{Binding !IsLaunching}">
                            <TextBlock Classes="action-lg" Text="{Binding Localization.LaunchRuntimeCheckAgain}" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
